{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetCat",
  "version": "0.5.0",
  "identifier": "com.kaitehan.netcat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "NetCat",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "devtools": true,
        "theme": "Light",
        "titleBarStyle": "Transparent",
        "backgroundColor": "#e7efff"
      },
      {
        "label": "pet",
        "title": "小橘桌面助手",
        "width": 220,
        "height": 220,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "kaite han",
    "copyright": "Copyright © 2026 kaite han",
    "category": "DeveloperTool",
    "shortDescription": "本地 HTTP/HTTPS 抓包与 Mock 工具",
    "longDescription": "NetCat（奈特猫）是一款面向开发者的本地 HTTP/HTTPS 抓包与 Mock 工具，可查看请求与响应、筛选流量、重放请求、构造 Mock，并管理本地 CA 与系统代理。流量、规则与设置默认只保存在本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
