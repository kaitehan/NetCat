{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "bridge/src/**/*.ts",
    "plugin-netcat/src/**/*.ts",
    "runtime/src/**/*.ts"
  ]
}
