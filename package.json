{
  "name": "netcat",
  "private": true,
  "version": "0.8.3",
  "author": "kaite han",
  "type": "module",
  "workspaces": [
    "harness/bridge",
    "harness/plugin-netcat",
    "harness/profile"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:budget": "npm run build && node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.windows.conf.json",
    "harness:test": "node --test harness/tests/*.test.ts",
    "harness:build": "tsc -p harness/tsconfig.json",
    "harness:verify": "npm run harness:test && npm run harness:build",
    "harness:bundle": "npm run harness:build && node harness/scripts/build-runtime.mjs",
    "harness:smoke": "npm run harness:build && node harness/scripts/smoke-runtime.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@tanstack/vue-virtual": "^3.13.48",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "dompurify": "^3.5.0",
    "marked": "^18.3.0",
    "monaco-editor": "^0.57.0",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "type-fest": "^2.19.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.16",
    "vue-tsc": "^2.2.0"
  }
}
